{
  "name": "instrument-atlas-sounds",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Playable sound-source registry for Instrument Atlas, prioritizing physical modeling engines with licensed sample fallbacks.",
  "exports": {
    "./resolve": "./src/resolve/resolve-sound-source.mjs"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "build:skip-validation": "node scripts/build.mjs --skip-validation",
    "package": "node scripts/package-release.mjs",
    "package:from-dist": "node scripts/package-release.mjs --skip-build",
    "check:boundaries": "node scripts/check-license-boundaries.mjs",
    "ci": "npm run validate && npm run build:skip-validation && npm run resolve:example && npm run resolve:saas && npm run resolve:metadata && npm run resolve:expected-rejection && npm run package:from-dist && npm run check:boundaries",
    "resolve:example": "node examples/resolve-sound-source.mjs",
    "resolve:saas": "node examples/resolve-sound-source.mjs examples/saas-safe-success-request.json",
    "resolve:metadata": "node examples/resolve-sound-source.mjs examples/metadata-resolve-request.json",
    "resolve:expected-rejection": "node examples/resolve-expected-rejection.mjs examples/saas-safe-expected-rejection-request.json",
    "render:karplus": "node examples/render-karplus-strong.mjs"
  },
  "keywords": [
    "audio",
    "music",
    "instrument",
    "physical-modeling",
    "sound-design",
    "sample-library",
    "sound-registry",
    "metadata",
    "json"
  ],
  "license": "MIT",
  "devDependencies": {
    "fflate": "^0.8.3"
  }
}
