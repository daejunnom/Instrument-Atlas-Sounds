{
  "id": "commercial-safe",
  "title": "Commercial Safe",
  "description": "Allows sources intended to be usable in commercial workflows while blocking non-commercial, no-derivatives, copyleft-by-default, AGPL, proprietary, unknown, disputed, and unverified sources by default.",
  "allowCategories": [
    "public_domain",
    "permissive_code",
    "commercial_attribution"
  ],
  "allowLicenseGroups": [
    "public-domain",
    "permissive",
    "notice-attribution"
  ],
  "denyCategories": [
    "commercial_sharealike",
    "weak_copyleft",
    "server_only_copyleft",
    "strong_copyleft",
    "network_copyleft",
    "noncommercial",
    "no_derivatives",
    "proprietary",
    "unknown",
    "restricted",
    "to_be_verified"
  ],
  "denyLicenseGroups": [
    "sharealike",
    "weak-copyleft",
    "strong-copyleft",
    "network-copyleft",
    "noncommercial",
    "no-derivatives",
    "blocked"
  ],
  "denyLicenses": [
    "MPL-2.0",
    "LGPL-2.1-or-later",
    "LGPL-3.0-or-later",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "AGPL-3.0-only",
    "AGPL-3.0-or-later",
    "CC-BY-SA-4.0",
    "CC-BY-NC-4.0",
    "CC-BY-NC-SA-4.0",
    "CC-BY-NC-ND-4.0",
    "CC-BY-ND-4.0",
    "unknown",
    "proprietary",
    "disputed",
    "unverified"
  ],
  "denyRestrictions": [
    "sharealike_required",
    "noncommercial",
    "no_derivatives",
    "source_disclosure_required",
    "network_source_disclosure_required",
    "rights_unknown"
  ],
  "allowCommercialUseOnly": true,
  "allowAttributionRequired": true,
  "allowClientDistribution": true,
  "allowServerOnlyCopyleft": false,
  "preferPublicDomain": true,
  "requiresAttributionReport": true
}