{
  "id": "cc0-only",
  "title": "CC0 Only",
  "description": "Allows only CC0 or public-domain sound sources.",
  "allowCategories": [
    "public_domain"
  ],
  "denyCategories": [
    "permissive_code",
    "weak_copyleft",
    "server_only_copyleft",
    "network_copyleft",
    "restricted",
    "to_be_verified"
  ],
  "allowLicenses": [
    "CC0-1.0",
    "Public Domain"
  ],
  "denyLicenses": [
    "MIT",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "Apache-2.0",
    "MIT-STK",
    "LGPL-2.1-or-later",
    "LGPL-3.0",
    "MPL-2.0",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "AGPL-3.0-only",
    "AGPL-3.0-or-later",
    "CC-BY-NC",
    "CC-BY-ND",
    "unknown"
  ],
  "allowCommercialUseOnly": true,
  "allowAttributionRequired": false,
  "allowClientDistribution": true,
  "allowServerOnlyCopyleft": false,
  "preferPublicDomain": true
}