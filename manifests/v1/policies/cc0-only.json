    "strong_copyleft",
    "network_copyleft",
    "noncommercial",
    "no_derivatives",
    "proprietary",
    "unknown",
    "restricted",
    "to_be_verified"
  ],
  "denyLicenseGroups": [
    "permissive",
    "notice-attribution",
    "sharealike",
    "weak-copyleft",
    "strong-copyleft",
    "network-copyleft",
    "noncommercial",
    "no-derivatives",
    "blocked"
  ],
  "denyLicenses": [
    "MIT",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Zlib",
    "Apache-2.0",
