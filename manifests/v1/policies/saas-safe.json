{
  "id": "saas-safe",
  "title": "SaaS Safe",
  "description": "Allows server-side use of public-domain and permissive sources while blocking weak copyleft, GPL, AGPL, non-commercial, no-derivatives, proprietary, unknown, disputed, and unverified sources by default.",
  "allowCategories": [
    "public_domain",
    "permissive_code"
  ],
  "allowLicenseGroups": [
    "public-domain",
    "permissive"
  ],
  "denyCategories": [
    "weak_copyleft",
    "server_only_copyleft",
    "commercial_sharealike",
    "strong_copyleft",
    "network_copyleft",
    "noncommercial",
    "no_derivatives",
    "proprietary",
    "unknown",
    "restricted",
    "to_be_verified"
  ],
  "denyLicenseGroups": [
    "weak-copyleft",
    "strong-copyleft",
    "network-copyleft",
    "noncommercial",
    "no-derivatives",
    "blocked"
  ],
  "denyLicenses": [
    "MPL-2.0",
    "LGPL-2.1-or-later",
    "LGPL-3.0-or-later",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "AGPL-3.0-only",
    "AGPL-3.0-or-later",
    "CC-BY-NC-4.0",
    "CC-BY-NC-SA-4.0",
    "CC-BY-NC-ND-4.0",
    "CC-BY-ND-4.0",
    "unknown",
    "proprietary",
    "disputed",
    "unverified"
  ],
  "denyRestrictions": [
    "sharealike_required",
    "noncommercial",
    "no_derivatives",
    "source_disclosure_required",
    "network_source_disclosure_required",
    "saas_risk",
    "rights_unknown"
  ],
  "allowCommercialUseOnly": true,
  "allowNoticeRequired": true,
  "allowCreatorAttributionRequired": true,
  "allowOutputAttributionRequired": true,
  "allowClientDistribution": false,
  "allowServerOnlyCopyleft": false,
  "preferPublicDomain": true,
  "requiresNoticeReport": true,
  "requiresAttributionReport": true
}