{
  "schemaVersion": 1,
  "id": "strong-copyleft",
  "title": "Strong Copyleft Licenses",
  "description": "GPL-family licenses that should be optional, server-only by default, and never bundled into client-side code without explicit compliance handling.",
  "riskLevel": "high",
  "defaultBehavior": "opt_in_only",
  "licenseIds": [
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later"
  ],
  "licenseFamilies": [
    "strong_copyleft"
  ],
  "restrictions": [
    "source_disclosure_required",
    "client_distribution_risk",
    "integration_model_sensitive"
  ],
  "commercialUse": true,
  "derivativesAllowed": true,
  "redistributionAllowed": true,
  "noticeRequired": true,
  "shareAlikeRequired": true,
  "sourceDisclosureRequired": true,
  "networkSourceDisclosureRequired": false,
  "clientDistributionAllowed": false,
  "serverUseAllowed": "policy_dependent",
  "defaultIncludedInCore": false,
  "fetchableByDefault": false,
  "requiresExplicitConsent": true,
  "notes": [
    "GPL sources must not be included in default release packages.",
    "GPL sources must not be assigned client execution targets by default.",
    "Server-side use may still require careful isolation and compliance review."
  ],
  "licenseTextRequired": true,
  "noticeReportRequired": true,
  "creatorAttributionRequired": false,
  "outputAttributionRequired": false,
  "requiresNoticeReport": true,
  "requiresAttributionReport": false
}
