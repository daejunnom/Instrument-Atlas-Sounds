  "riskLevel": "very_high",
  "defaultBehavior": "blocked_by_default",
  "licenseIds": [
    "AGPL-3.0-only",
    "AGPL-3.0-or-later"
  ],
  "licenseFamilies": [
    "network_copyleft"
  ],
  "restrictions": [
    "source_disclosure_required",
    "network_source_disclosure_required",
    "client_distribution_risk",
    "saas_risk",
    "integration_model_sensitive"
  ],
  "commercialUse": true,
  "derivativesAllowed": true,
  "redistributionAllowed": true,
  "attributionRequired": true,
  "noticeRequired": true,
  "shareAlikeRequired": true,
  "sourceDisclosureRequired": true,
  "networkSourceDisclosureRequired": true,
  "clientDistributionAllowed": false,
  "serverUseAllowed": false,
  "defaultIncludedInCore": false,
  "fetchableByDefault": false,
  "requiresExplicitConsent": true,
  "notes": [
    "AGPL sources must be blocked from SaaS-safe workflows by default.",
