{
  "schemaVersion": 1,
  "id": "notice-attribution",
  "title": "Creator or Output Attribution Required",
  "description": "Sources that may be commercially usable but require creator attribution, generated-output attribution, or attribution reports.",
  "riskLevel": "medium",
  "defaultBehavior": "allow_with_report",
  "licenseIds": [
    "CC-BY-4.0"
  ],
  "licenseFamilies": [
    "commercial_attribution"
  ],
  "restrictions": [
    "creator_attribution_required",
    "output_attribution_required"
  ],
  "commercialUse": true,
  "derivativesAllowed": true,
  "redistributionAllowed": true,
  "noticeRequired": true,
  "licenseTextRequired": true,
  "noticeReportRequired": true,
  "creatorAttributionRequired": true,
  "outputAttributionRequired": true,
  "shareAlikeRequired": false,
  "sourceDisclosureRequired": false,
  "networkSourceDisclosureRequired": false,
  "clientDistributionAllowed": true,
  "serverUseAllowed": true,
  "defaultIncludedInCore": false,
  "fetchableByDefault": false,
  "requiresExplicitConsent": false,
  "requiresNoticeReport": true,
  "requiresAttributionReport": true,
  "notes": [
    "CC-BY sources require creator/output attribution.",
    "Apache-2.0 remains covered by the permissive group and may still require notice preservation, but it should not be treated as an output-attribution source by default."
  ]
}