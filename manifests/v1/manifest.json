    "commercialSafe": "policies/commercial-safe.json",
    "commercialSafeNoAttribution": "policies/commercial-safe-no-attribution.json",
    "commercialSafeWithAttribution": "policies/commercial-safe-with-attribution.json",
    "noncommercialOptIn": "policies/noncommercial-opt-in.json",
    "noDerivativesOptIn": "policies/no-derivatives-opt-in.json",
